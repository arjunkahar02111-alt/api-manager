# ==============================================================================
# KARVION API MANAGER - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env and customize secrets before running the application
# Canonical Domain: https://api.karviontechnologies.in
# ==============================================================================

NODE_ENV=production
CANONICAL_DOMAIN=api.karviontechnologies.in
PUBLIC_BASE_URL=https://api.karviontechnologies.in
FRONTEND_ORIGIN=https://api.karviontechnologies.in
API_BASE_PATH=/api/v1
GATEWAY_BASE_PATH=/v1

# Service Ports
BACKEND_PORT=3000
GATEWAY_PORT=3001
FRONTEND_PORT=8080

# Database Configuration (MongoDB)
# For local VPS deployment without Docker: mongodb://127.0.0.1:27017/arjun_api_manager
# For Docker Compose deployment: mongodb://mongodb:27017/arjun_api_manager
MONGODB_URI=mongodb://127.0.0.1:27017/arjun_api_manager
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# Redis Configuration (High-Speed Anti-Sharing Counters, Cache, BullMQ)
# For local VPS deployment without Docker: 127.0.0.1
# For Docker Compose deployment: redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=arjun:

# Security & Cryptography Secrets (MANDATORY: Generate fresh random keys for production!)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ADMIN_SECRET=replace_with_64_char_crypto_random_secret_for_admin_jwt
JWT_CUSTOMER_SECRET=replace_with_64_char_crypto_random_secret_for_customer_jwt
DATA_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes_256_gcm_secret_storage
COOKIE_SECRET=replace_with_crypto_random_cookie_signing_secret

# Token Lifespans
JWT_ADMIN_ACCESS_EXPIRY=15m
JWT_ADMIN_REFRESH_EXPIRY=7d
JWT_CUSTOMER_ACCESS_EXPIRY=2h

# Initial Super Admin Seed (Used ONLY on initial DB bootstrap if no administrator exists)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=AdminStrongSecurePassword2026!
SUPER_ADMIN_EMAIL=admin@karviontechnologies.in

# Upstream Proxy Guard & Anti-SSRF Constraints
PROXY_REQUEST_TIMEOUT_MS=15000
PROXY_MAX_BODY_BYTES=10485760
PROXY_MAX_RESPONSE_BYTES=10485760
PROXY_ALLOW_PRIVATE_IPS=false

# Discord Webhook Incident & Monitoring Alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1471007980484034562/I858won4YW6XqwnhXmGpXu0V3e2R6k5epKbwSCvj4Q72ElLltA51PEaiuJZNBbPIAPWn

# Telegram Bot Notification Alerts (Optional)
TELEGRAM_BOT_TOKEN=8553919452:AAGVep2aITbg0eKRwMiTHNhzWkFLqLVRtGs
TELEGRAM_CHAT_ID=2137698437

# Email SMTP Settings (Optional - for email verification & password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@karviontechnologies.in

# Monitoring & Automated Backup
BACKUP_STORAGE_DIR=/var/backups/arjun
PROMETHEUS_METRICS_ENABLED=true
